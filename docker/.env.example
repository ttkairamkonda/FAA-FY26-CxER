# Copy to .env in the repo root (it is git-ignored) and fill in.
# Hugging Face token with access to meta-llama/Llama-3.3-70B-Instruct
# (accept the license on its model page first).
HF_TOKEN=

# Optional overrides
# CUDA_VISIBLE_DEVICES=0,1,2,3
# TENSOR_PARALLEL_SIZE=4
# JUDGE_MODEL=meta-llama/Llama-3.3-70B-Instruct
# PROMPT_TYPE=cot_v3
# MODELS_DIR=/opt/dlami/nvme/models   # big fast disk for the ~140 GB of judge weights
# CXER_IMAGE=<account>.dkr.ecr.<region>.amazonaws.com/faa-cxer-pipeline:gpu
